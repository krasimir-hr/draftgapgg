# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False

# Hosts allowed to serve the app (comma-separated, no scheme)
ALLOWED_HOSTS=localhost,127.0.0.1,api.yourdomain.com

# Database — leave DB_NAME empty to fall back to local SQLite
DB_NAME=draftgap
DB_USER=draftgap
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

# CORS — frontend origins allowed to call the API (comma-separated, with scheme)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com

# CSRF — trusted origins for the Django admin behind HTTPS (comma-separated, with scheme)
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://api.yourdomain.com

# Set True only if a proxy is NOT already redirecting HTTP→HTTPS (Caddy does, so keep False)
SECURE_SSL_REDIRECT=False

# Oracle's Elixir enrichment — free Google Drive API key (Cloud Console →
# APIs & Services → Credentials → Create API key; enable "Google Drive API").
# Needed only for the automated daily `pull_oracleselixir`; local --file mode
# works without it. Leave blank to disable downloads.
OE_DRIVE_API_KEY=
# Optional: where to mirror the downloaded per-year CSV (defaults to backend/oe_data)
# OE_DATA_DIR=

# Leaguepedia (Fandom) bot credentials for the sync_* management commands.
# Create a bot password at https://lol.fandom.com/wiki/Special:BotPasswords
LEAGUEPEDIA_USERNAME=
LEAGUEPEDIA_PASSWORD=

# Media hosting on Cloudflare R2 (S3-compatible). Leave R2_BUCKET blank to
# store uploaded/scraped images on the local filesystem (dev default).
# Create the bucket + an API token (R2 → Manage API Tokens) in the Cloudflare
# dashboard, then enable public access to get the public URL below.
R2_BUCKET=
# Account endpoint, e.g. https://<accountid>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public host that media URLs are built from, WITHOUT scheme — either the
# bucket's r2.dev domain (e.g. pub-xxxx.r2.dev) or a custom domain (media.yourdomain.com)
R2_PUBLIC_URL=
